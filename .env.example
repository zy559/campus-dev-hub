# Local development
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-secret"

# Production database used by prisma/schema.prisma
# Vercel Postgres / Supabase / Neon all provide a PostgreSQL connection string.
POSTGRES_PRISMA_URL="postgresql://user:password@host:5432/database?sslmode=require"

# Vercel Blob, required for image/video uploads.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxx"

# Optional email provider.
RESEND_API_KEY=""

# WeChat Mini Program login.
WECHAT_APP_ID=""
WECHAT_APP_SECRET=""
