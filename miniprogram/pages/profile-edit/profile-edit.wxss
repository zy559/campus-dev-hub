.header {
  margin-bottom: 24rpx;
}

.form {
  padding: 28rpx;
}

.avatar-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 26rpx;
}

.avatar-row button {
  min-height: 68rpx;
  border-radius: 999rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 900;
}

.field {
  margin-top: 24rpx;
}

.field text,
.tag-title {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 900;
  color: #334155;
}

.field input,
.field textarea {
  width: 100%;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  color: #0f172a;
  font-size: 28rpx;
  padding: 22rpx 24rpx;
}

.field textarea {
  min-height: 190rpx;
  line-height: 1.6;
}

.tag-box {
  margin-top: 26rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.tags text {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ccfbf1;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 800;
}

.save {
  margin-top: 28rpx;
  min-height: 88rpx;
  border-radius: 999rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 900;
}
