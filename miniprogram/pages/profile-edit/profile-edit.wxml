<view class="page">
  <view class="header">
    <text class="eyebrow">个人资料</text>
    <view class="section-title">编辑个人资料</view>
  </view>

  <view class="form glass">
    <view class="avatar-row">
      <view class="avatar">{{name[0]}}</view>
      <button bindtap="chooseAvatar">修改头像</button>
    </view>

    <view class="field">
      <text>昵称</text>
      <input value="{{name}}" data-key="name" bindinput="input" />
    </view>
    <view class="field">
      <text>学校/年级</text>
      <input value="{{school}}" data-key="school" bindinput="input" />
    </view>
    <view class="field">
      <text>个人简介</text>
      <textarea value="{{bio}}" data-key="bio" bindinput="input" />
    </view>

    <view class="tag-box">
      <text class="tag-title">兴趣标签</text>
      <view class="tags">
        <text wx:for="{{tags}}" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <button class="save" bindtap="save">保存</button>
</view>
