.admin-page {
  padding-bottom: 160rpx;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 30rpx;
}

.desc {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.55;
}

.hero button {
  flex-shrink: 0;
  margin: 0;
  min-width: 128rpx;
  min-height: 72rpx;
  border-radius: 999rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 20rpx 0;
}

.stat {
  padding: 24rpx 12rpx;
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 40rpx;
  font-weight: 900;
  color: #0f172a;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  font-weight: 800;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  padding: 12rpx;
  margin-bottom: 20rpx;
}

.tabs button {
  margin: 0;
  min-height: 72rpx;
  border-radius: 22rpx;
  background: transparent;
  color: #64748b;
  font-size: 26rpx;
  font-weight: 900;
}

.tabs button.active {
  background: #0d9488;
  color: #ffffff;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.empty {
  padding: 48rpx 28rpx;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
  font-weight: 800;
}

.item {
  display: flex;
  align-items: stretch;
  gap: 18rpx;
  padding: 24rpx;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.tag {
  max-width: 360rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 800;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.time {
  color: #94a3b8;
  font-size: 22rpx;
}

.title {
  display: block;
  margin-top: 18rpx;
  color: #0f172a;
  font-size: 31rpx;
  font-weight: 900;
  line-height: 1.35;
}

.content {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.6;
}

.meta {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  font-size: 23rpx;
}

.danger {
  align-self: center;
  flex-shrink: 0;
  margin: 0;
  width: 112rpx;
  min-height: 68rpx;
  border-radius: 999rpx;
  background: #fff1f2;
  color: #dc2626;
  border: 1rpx solid #fecaca;
  font-size: 24rpx;
  font-weight: 900;
}
