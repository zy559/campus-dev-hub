.detail-page {
  padding-bottom: 170rpx;
}

.hero {
  position: relative;
  padding: 18rpx;
  overflow: hidden;
}

.match-badge {
  position: absolute;
  left: 50%;
  top: 28rpx;
  z-index: 2;
  transform: translateX(-50%);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.88);
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 900;
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.08);
}

.photo {
  position: relative;
  height: 720rpx;
  border-radius: 28rpx;
  background: radial-gradient(circle at 50% 28%, rgba(255,255,255,0.95), transparent 20%),
    linear-gradient(135deg, #ffffff 0%, #ccfbf1 45%, #dbeafe 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.photo.sky {
  background: radial-gradient(circle at 48% 22%, rgba(255,255,255,0.98), transparent 18%),
    linear-gradient(135deg, #ffffff 0%, #e0f2fe 44%, #ccfbf1 100%);
}

.photo.mint {
  background: radial-gradient(circle at 50% 26%, rgba(255,255,255,0.98), transparent 18%),
    linear-gradient(135deg, #ffffff 0%, #dcfce7 42%, #cffafe 100%);
}

.photo-mark {
  font-size: 150rpx;
  font-weight: 900;
  color: rgba(13, 148, 136, 0.22);
}

.photo-caption {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.84);
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 900;
}

.info {
  margin-top: 20rpx;
  padding: 30rpx;
}

.top-line {
  align-items: flex-start;
}

.identity {
  min-width: 0;
}

.name {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #0f172a;
}

.meta {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  font-weight: 800;
}

.online {
  min-width: 96rpx;
  padding: 12rpx 0;
  border-radius: 24rpx;
  background: #ecfdf5;
  color: #0f766e;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
}

.online text {
  display: block;
}

.chip-block {
  margin-top: 28rpx;
}

.block-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #0f172a;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475569;
  border: 1rpx solid #e2e8f0;
  font-size: 24rpx;
  font-weight: 800;
}

.chip.strong {
  background: #ccfbf1;
  color: #0f766e;
  border-color: #99f6e4;
}

.intro {
  display: block;
  margin-top: 30rpx;
  color: #0f172a;
  font-size: 29rpx;
  line-height: 1.75;
}

.manage-row {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.manage-row button {
  min-height: 68rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f766e;
  border: 1rpx solid #ccfbf1;
  font-size: 24rpx;
  font-weight: 900;
}

.manage-row button.danger {
  color: #dc2626;
  border-color: #fecaca;
}

.actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 34rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.12);
}

.action {
  min-height: 76rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.ghost {
  background: #ffffff;
  color: #0f766e;
  border: 1rpx solid #ccfbf1;
}

.like {
  background: #38bdf8;
  color: #ffffff;
}

.chat {
  background: #0d9488;
  color: #ffffff;
}
