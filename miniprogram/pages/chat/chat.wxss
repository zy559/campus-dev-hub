.chat-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 18rpx 24rpx 150rpx;
  background: linear-gradient(180deg, #ffffff 0%, #f1fbfa 50%, #f8fafc 100%);
}

.chat-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx;
}

.head-main {
  flex: 1;
}

.name {
  display: block;
  font-size: 28rpx;
  font-weight: 900;
  color: #0f172a;
}

.desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.mode {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 900;
}

.mode.private {
  background: #fef3c7;
  color: #b45309;
}

.private-tip {
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #fffbeb;
  color: #92400e;
  font-size: 23rpx;
  line-height: 1.5;
}

.messages {
  height: calc(100vh - 300rpx);
  padding-top: 24rpx;
}

.bubble-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.bubble-row.mine {
  justify-content: flex-end;
}

.mini-avatar {
  width: 54rpx;
  height: 54rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #14b8a6, #38bdf8);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
}

.mini-avatar.me {
  background: linear-gradient(135deg, #0d9488, #14b8a6);
}

.bubble {
  max-width: 500rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  color: #0f172a;
  font-size: 27rpx;
  line-height: 1.55;
}

.mine-normal {
  background: #0d9488;
  color: #ffffff;
  border-color: #0d9488;
}

.mine-private {
  background: #f59e0b;
  color: #ffffff;
  border-color: #f59e0b;
}

.time {
  display: block;
  margin-top: 6rpx;
  color: #64748b;
  font-size: 20rpx;
}

.input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx;
  background: rgba(255,255,255,0.96);
  box-shadow: 0 -12rpx 34rpx rgba(15, 23, 42, 0.08);
}

.input-bar input {
  flex: 1;
  min-height: 76rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  padding: 0 24rpx;
  color: #0f172a;
  font-size: 27rpx;
}

.input-bar button {
  width: 128rpx;
  min-height: 76rpx;
  border-radius: 999rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.input-bar button.private-send {
  background: #f59e0b;
}
