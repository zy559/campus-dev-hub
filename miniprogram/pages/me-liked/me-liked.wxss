.header {
  padding: 30rpx;
  margin-bottom: 22rpx;
}

.desc {
  display: block;
  margin-top: 12rpx;
  color: #64748b;
  font-size: 26rpx;
  line-height: 1.55;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.person-card {
  display: flex;
  gap: 18rpx;
  padding: 22rpx;
}

.avatar-large {
  flex-shrink: 0;
  width: 118rpx;
  height: 150rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #ffffff, #ccfbf1, #dbeafe);
  color: rgba(13, 148, 136, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: 900;
}

.avatar-large.sky {
  background: linear-gradient(135deg, #ffffff, #e0f2fe, #ccfbf1);
}

.avatar-large.mint {
  background: linear-gradient(135deg, #ffffff, #dcfce7, #cffafe);
}

.person-main {
  min-width: 0;
  flex: 1;
}

.person-name {
  display: block;
  font-size: 30rpx;
  font-weight: 900;
  color: #0f172a;
}

.person-meta {
  display: block;
  margin-top: 4rpx;
  color: #64748b;
  font-size: 23rpx;
}

.signal {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 21rpx;
  font-weight: 900;
}

.intro {
  display: block;
  margin-top: 14rpx;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.55;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.chips text {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  color: #475569;
  font-size: 22rpx;
  font-weight: 800;
}
