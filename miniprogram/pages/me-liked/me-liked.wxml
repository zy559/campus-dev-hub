<view class="page">
  <view class="header glass">
    <text class="eyebrow">我的关系</text>
    <view class="section-title">我喜欢的</view>
    <text class="desc">这些是你感兴趣的同学，适合继续聊天或匿名开口。</text>
  </view>

  <view class="card-list">
    <view wx:for="{{cards}}" wx:key="id" data-id="{{item.id}}" bindtap="openCard" class="person-card card">
      <view class="avatar-large {{item.imageTone}}">{{item.name[0]}}</view>
      <view class="person-main">
        <view class="between">
          <view>
            <text class="person-name">{{item.name}}</text>
            <text class="person-meta">{{item.meta}}</text>
          </view>
          <text class="signal">{{item.signal}}</text>
        </view>
        <text class="intro">{{item.intro}}</text>
        <view class="chips">
          <text wx:for="{{item.needs}}" wx:key="*this">{{item}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
