.detail-page {
  padding-bottom: 180rpx;
}

.post-main {
  padding: 30rpx;
}

.post-head,
.comments-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.author {
  gap: 14rpx;
}

.small-avatar,
.comment-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #14b8a6, #38bdf8);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 900;
}

.author-name,
.comment-author {
  display: block;
  font-size: 26rpx;
  font-weight: 900;
  color: #0f172a;
}

.post-time,
.comment-time {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.tag {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 900;
}

.source-tag {
  display: inline-flex;
  margin-top: 24rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
  font-size: 22rpx;
  font-weight: 900;
}

.post-title {
  display: block;
  margin-top: 30rpx;
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 900;
  color: #0f172a;
}

.post-content {
  display: block;
  margin-top: 24rpx;
  font-size: 30rpx;
  line-height: 1.8;
  color: #1e293b;
}

.post-image {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 26rpx;
  background: #f1f5f9;
}

.post-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 32rpx;
}

.post-actions button {
  min-height: 78rpx;
  border-radius: 999rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}

.post-actions button.ghost {
  background: #ffffff;
  color: #0f766e;
  border: 1rpx solid #ccfbf1;
}

.comments {
  margin-top: 20rpx;
  padding: 28rpx;
}

.comments-title {
  margin-top: 4rpx;
  font-size: 34rpx;
  font-weight: 900;
  color: #0f172a;
}

.comments-tip {
  max-width: 260rpx;
  color: #64748b;
  font-size: 23rpx;
  line-height: 1.45;
  text-align: right;
}

.comment-list {
  margin-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.comment-item:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.comment-body {
  min-width: 0;
  flex: 1;
}

.comment-content {
  display: block;
  margin-top: 10rpx;
  color: #334155;
  font-size: 27rpx;
  line-height: 1.65;
}

.comment-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 18rpx 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -12rpx 34rpx rgba(15, 23, 42, 0.08);
}

.comment-bar input {
  flex: 1;
  min-height: 76rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  padding: 0 24rpx;
  color: #0f172a;
  font-size: 27rpx;
}

.comment-bar button {
  width: 128rpx;
  min-height: 76rpx;
  border-radius: 999rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}
