<view class="page">
  <view class="header glass">
    <view>
      <text class="eyebrow">我的内容</text>
      <view class="section-title">我的帖子</view>
      <text class="desc">你发布过的动态会沉淀成个人展示，也方便同学继续联系你。</text>
    </view>
    <button bindtap="goPublish">发布</button>
  </view>

  <view class="feed">
    <view wx:for="{{posts}}" wx:key="id" data-id="{{item.id}}" data-remote="{{item.remote}}" bindtap="openPost" class="post card">
      <view class="between">
        <view class="row author">
          <view class="small-avatar">{{item.author[0]}}</view>
          <view>
            <text class="author-name">{{item.author}}</text>
            <text class="post-time">{{item.time}}</text>
          </view>
        </view>
        <text class="tag">{{item.tag}}</text>
      </view>
      <text class="post-title">{{item.title}}</text>
      <text class="post-content">{{item.content}}</text>
      <view class="post-footer">
        <text>{{item.comments}} 条评论</text>
        <text>查看详情</text>
      </view>
    </view>
  </view>
</view>
