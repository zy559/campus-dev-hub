<view class="page">
  <view class="header">
    <text class="eyebrow">发布</text>
    <view class="section-title">让同学找到你</view>
    <text class="header-desc">资料卡用于今日遇见，动态用于栏目广场。</text>
  </view>

  <view class="switch glass">
    <button data-mode="card" bindtap="setMode" class="{{mode === 'card' ? 'active' : ''}}">资料卡</button>
    <button data-mode="post" bindtap="setMode" class="{{mode === 'post' ? 'active' : ''}}">动态</button>
  </view>

  <view wx:if="{{mode === 'card'}}" class="form glass">
    <view class="photo-upload {{cover ? 'has-cover' : ''}}" bindtap="chooseImage">
      <image wx:if="{{cover}}" class="cover-preview" src="{{cover}}" mode="aspectFill" />
      <block wx:else>
        <text>+</text>
        <text>上传一张清晰照片</text>
      </block>
    </view>
    <view class="field">
      <text>昵称</text>
      <input value="{{nickname}}" data-key="nickname" bindinput="input" placeholder="例如：林同学" />
    </view>
    <view class="field">
      <text>学校/年级</text>
      <input value="{{school}}" data-key="school" bindinput="input" placeholder="例如：北华航天工业学院 · 大三" />
    </view>
    <view class="field">
      <text>想找什么</text>
      <input value="{{needsText}}" data-key="needsText" bindinput="input" placeholder="例如：找对象、找搭子、比赛队友" />
    </view>
    <view class="field">
      <text>兴趣标签</text>
      <input value="{{interestsText}}" data-key="interestsText" bindinput="input" placeholder="例如：前端、跑步、电影" />
    </view>
    <view class="field">
      <text>自我介绍 / 需求</text>
      <textarea value="{{intro}}" data-key="intro" bindinput="input" placeholder="你是谁，想认识什么样的人，希望一起做什么。" />
    </view>
  </view>

  <view wx:else class="form glass">
    <view class="template">
      <view class="between">
        <view>
          <text class="template-title">发布模板</text>
          <text class="template-desc">把关键信息写清楚，减少水贴。</text>
        </view>
        <button bindtap="applyTemplate">套用</button>
      </view>
      <scroll-view scroll-x enhanced show-scrollbar="{{false}}">
        <view class="template-row">
          <button wx:for="{{templateKeys}}" wx:key="*this" data-value="{{item}}" bindtap="selectTemplate" class="{{activeTemplate === item ? 'selected' : ''}}">{{item}}</button>
        </view>
      </scroll-view>
    </view>

    <view class="field">
      <text>标题</text>
      <input value="{{title}}" data-key="title" bindinput="input" placeholder="一句话说明你想发布什么" />
    </view>
    <view class="field">
      <text>正文</text>
      <textarea value="{{content}}" data-key="content" bindinput="input" placeholder="写清楚时间、地点、需求、联系方式。" />
    </view>
  </view>

  <button class="submit" bindtap="submit">{{submitting ? "发布中..." : "发布"}}</button>
</view>
