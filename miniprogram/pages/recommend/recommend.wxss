.guide {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.guide-title {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #475569;
}

.guide-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.small-primary,
.small-ghost,
.mini-btn {
  margin: 0;
  min-height: 64rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
}

.small-primary {
  background: #0d9488;
  color: white;
}

.small-ghost,
.mini-btn {
  background: #f1f5f9;
  color: #475569;
}

.header {
  margin-bottom: 22rpx;
}

.filter-row {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.filter-inner {
  display: flex;
  gap: 16rpx;
  padding-bottom: 4rpx;
}

.profile-shell {
  position: relative;
  overflow: hidden;
  padding: 18rpx;
}

.match-badge {
  position: absolute;
  left: 50%;
  top: 22rpx;
  z-index: 2;
  transform: translateX(-50%);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.86);
  color: #0f766e;
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 8rpx 24rpx rgba(15, 118, 110, 0.08);
  font-size: 22rpx;
  font-weight: 900;
}

.profile-card {
  overflow: hidden;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 18rpx 54rpx rgba(15, 23, 42, 0.08);
}

.photo {
  position: relative;
  height: 660rpx;
  background: radial-gradient(circle at 50% 28%, rgba(255,255,255,0.95), transparent 20%),
    linear-gradient(135deg, #ffffff 0%, #ccfbf1 45%, #dbeafe 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo.sky {
  background: radial-gradient(circle at 48% 22%, rgba(255,255,255,0.98), transparent 18%),
    linear-gradient(135deg, #ffffff 0%, #e0f2fe 44%, #ccfbf1 100%);
}

.photo.mint {
  background: radial-gradient(circle at 50% 26%, rgba(255,255,255,0.98), transparent 18%),
    linear-gradient(135deg, #ffffff 0%, #dcfce7 42%, #cffafe 100%);
}

.photo-mark {
  font-size: 140rpx;
  font-weight: 900;
  color: rgba(13, 148, 136, 0.22);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.photo-caption {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #0f172a;
  font-size: 24rpx;
  font-weight: 900;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.06);
}

.profile-body {
  padding: 28rpx;
}

.top-line {
  align-items: flex-start;
}

.name {
  display: block;
  font-size: 48rpx;
  font-weight: 900;
  color: #0f172a;
}

.identity {
  min-width: 0;
}

.meta {
  display: inline-flex;
  margin-top: 12rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
  font-weight: 800;
}

.online {
  min-width: 96rpx;
  padding: 12rpx 0;
  border-radius: 24rpx;
  background: #ecfdf5;
  color: #0f766e;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
}

.online text {
  display: block;
}

.chip-block {
  margin-top: 28rpx;
}

.block-title {
  font-size: 26rpx;
  font-weight: 900;
  color: #0f172a;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #475569;
  border: 1rpx solid #e2e8f0;
  font-size: 24rpx;
  font-weight: 800;
}

.chip.strong {
  background: #ccfbf1;
  color: #0f766e;
  border-color: #99f6e4;
}

.intro {
  display: block;
  margin-top: 28rpx;
  margin-bottom: 22rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #0f172a;
}

.actions {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 34rpx;
  z-index: 20;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  padding: 14rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.96);
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.12);
}

.action {
  min-height: 76rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 900;
}

.skip {
  background: #ffffff;
  color: #64748b;
  border: 1rpx solid #e2e8f0;
}

.like {
  background: #38bdf8;
  color: #ffffff;
}

.chat {
  background: #0d9488;
  color: #ffffff;
}

.private-btn {
  margin: 24rpx auto 0;
  background: transparent;
  color: #0f766e;
  font-size: 26rpx;
  font-weight: 900;
}

.empty {
  padding: 52rpx 32rpx;
  text-align: center;
}

.empty-title,
.empty-desc {
  display: block;
}

.empty-title {
  color: #0f172a;
  font-size: 32rpx;
  font-weight: 900;
}

.empty-desc {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 26rpx;
}

.empty button {
  margin-top: 28rpx;
  width: 260rpx;
  min-height: 72rpx;
  border-radius: 999rpx;
  background: #0d9488;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 900;
}
