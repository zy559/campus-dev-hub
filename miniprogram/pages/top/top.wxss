.hero {
  padding: 30rpx;
  margin-bottom: 22rpx;
}

.hero-desc {
  display: block;
  margin-top: 14rpx;
  max-width: 620rpx;
  color: #475569;
  font-size: 27rpx;
  line-height: 1.6;
}

.hero-stats {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.hero-stats view {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.78);
  border: 1rpx solid #e2e8f0;
}

.stat-num {
  display: block;
  font-size: 42rpx;
  font-weight: 900;
  color: #0f172a;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 800;
}

.rank-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rank-card {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx;
}

.rank-no {
  flex-shrink: 0;
  width: 86rpx;
  height: 86rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 28rpx;
  font-weight: 900;
}

.rank-no.gold {
  background: linear-gradient(135deg, #0d9488, #38bdf8);
  color: #ffffff;
  box-shadow: 0 14rpx 34rpx rgba(13, 148, 136, 0.22);
}

.rank-main {
  min-width: 0;
  flex: 1;
}

.tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfdf5;
  color: #0f766e;
  font-size: 22rpx;
  font-weight: 900;
}

.heat {
  color: #64748b;
  font-size: 23rpx;
  font-weight: 800;
}

.rank-title {
  display: block;
  margin-top: 18rpx;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 900;
  color: #0f172a;
}

.rank-content {
  display: block;
  margin-top: 10rpx;
  color: #475569;
  font-size: 25rpx;
  line-height: 1.6;
}

.rank-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: #64748b;
  font-size: 23rpx;
}
