<view class="page">
  <view class="profile glass">
    <view class="profile-top">
      <view class="profile-copy">
        <text class="eyebrow">我的围炉</text>
        <text class="name">{{user.name}}</text>
        <text class="school">{{user.school}}</text>
      </view>
      <view class="avatar">{{user.name[0]}}</view>
    </view>

    <view class="login-state {{isLoggedIn ? 'online' : ''}}">
      <text>{{isLoggedIn ? (user.impersonating ? "管理员代登录中" : "微信已登录") : "登录后可同步发布、评论和聊天"}}</text>
    </view>

    <view class="stats">
      <view>
        <text class="num">{{user.posts}}</text>
        <text class="label">已发布</text>
      </view>
      <view>
        <text class="num">{{user.liked}}</text>
        <text class="label">我喜欢的</text>
      </view>
      <view>
        <text class="num">{{user.likedBy}}</text>
        <text class="label">喜欢我的</text>
      </view>
    </view>

    <view class="quick">
      <button wx:if="{{!isLoggedIn}}" class="primary" loading="{{loginLoading}}" bindtap="login">微信登录</button>
      <button wx:else bindtap="logout">退出登录</button>
      <button bindtap="openMenu" data-path="/pages/profile-edit/profile-edit">编辑资料</button>
      <button wx:if="{{user.role === 'admin' && !user.impersonating}}" class="admin-solid" bindtap="openMenu" data-path="/pages/admin/admin">管理数据</button>
      <button wx:if="{{user.role === 'admin' && !user.impersonating}}" class="admin" bindtap="impersonateUser">代登录用户</button>
      <button wx:if="{{user.impersonating}}" class="admin" bindtap="restoreAdmin">返回管理员</button>
    </view>
  </view>

  <view class="highlight-row">
    <view wx:for="{{highlights}}" wx:key="label" class="highlight card">
      <text class="highlight-value">{{item.value}}</text>
      <text class="highlight-label">{{item.label}}</text>
    </view>
  </view>

  <view class="notice">继续完善资料卡，会让更多同频同学找到你。</view>

  <view class="menu glass">
    <view wx:for="{{menus}}" wx:key="label" data-path="{{item.path}}" bindtap="openMenu" class="menu-item">
      <text>{{item.label}}</text>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
