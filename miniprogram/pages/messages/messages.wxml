<view class="page">
  <view class="between header glass">
    <view>
      <text class="eyebrow">会话中心</text>
      <view class="section-title">聊天</view>
      <text class="header-desc">从资料卡、帖子或匿名开口开始联系。</text>
    </view>
    <button bindtap="newChat">发起聊天</button>
  </view>

  <view class="list">
    <view wx:for="{{conversations}}" wx:key="id" data-private="{{item.privateMode}}" bindtap="openChat" class="chat-card card">
      <view class="avatar">{{item.name[0]}}</view>
      <view class="chat-main">
        <view class="between">
          <text class="chat-name">{{item.name}}</text>
          <text class="chat-time">{{item.time}}</text>
        </view>
        <text class="chat-last">{{item.last}}</text>
      </view>
      <text wx:if="{{item.privateMode}}" class="private-tag">隐私</text>
    </view>
  </view>
</view>
